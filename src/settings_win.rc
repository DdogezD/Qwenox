// settings_win.exe file icon (shown in Explorer); compiled by build_win.sh when llvm-rc exists.
// The window icon does not depend on this: it comes from launch_win_icon.inc.
1 ICON "launch_win.ico"
// PerMonitorV2 DPI awareness (type 24 = RT_MANIFEST). Without rc tooling the
// runtime SetProcessDpiAwarenessContext call in main() still applies.
1 24 "settings_win.manifest"
